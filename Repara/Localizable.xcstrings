{
  "sourceLanguage": "en",
  "strings": {
    "%@ also read the reports filed under related types.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ leu também as ocorrências registadas em tipos relacionados."
          }
        }
      }
    },
    "%@ declined this request. Write the description yourself and pick a type — everything else still works.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ recusou este pedido. Escreva a descrição você mesmo e escolha um tipo — tudo o resto continua a funcionar."
          }
        }
      }
    },
    "%@ from your pin": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "a %@ do seu marcador"
          }
        }
      }
    },
    "%@ models": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelos %@"
          }
        }
      }
    },
    "%@ picks one of 127 report types and drafts the Portuguese. You read and can edit both before anything is filed.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ escolhe um de 127 tipos de ocorrência e redige o texto em português. Pode ler e editar ambos antes de submeter."
          }
        }
      }
    },
    "%@ · drafted, low confidence": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · redigido, confiança baixa"
          }
        }
      }
    },
    "%@ · drafted, medium confidence": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · redigido, confiança média"
          }
        }
      }
    },
    "%@ · pin on the building": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · marcador sobre o edifício"
          }
        }
      }
    },
    "%@ · pin on the street": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · marcador sobre a rua"
          }
        }
      }
    },
    "%@'s reply was cut off before it finished. Try again.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta do %@ foi cortada antes de terminar. Tente outra vez."
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld %@ reports at this spot": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld %2$@ reports at this spot"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ocorrências de %2$@ neste local"
          }
        }
      }
    },
    "%lld / %lld": {
      "shouldTranslate": false
    },
    "%lld checks outstanding": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld verificações por responder"
          }
        }
      }
    },
    "%lld closed": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fechadas"
          }
        }
      }
    },
    "%lld closed reports": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld closed report"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld closed reports"
                }
              }
            }
          }
        },
        "pt-PT": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ocorrência fechada"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ocorrências fechadas"
                }
              }
            }
          }
        }
      }
    },
