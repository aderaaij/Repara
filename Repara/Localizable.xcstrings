                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg ocorrências fechadas a menos de %2$lld m"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%lld closed reports within %lld m, filed in %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@reports@"
          },
          "substitutions": {
            "reports": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg closed report within %2$lld m, filed in %3$@"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg closed reports within %2$lld m, filed in %3$@"
                    }
                  }
                }
              }
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@reports@"
          },
          "substitutions": {
            "reports": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg ocorrência fechada a menos de %2$lld m, registada em %3$@"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg ocorrências fechadas a menos de %2$lld m, registadas em %3$@"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%lld closed reports within %lld m, filed since %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@reports@"
          },
          "substitutions": {
            "reports": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg closed report within %2$lld m, filed since %3$@"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg closed reports within %2$lld m, filed since %3$@"
                    }
                  }
                }
              }
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@reports@"
          },
          "substitutions": {
            "reports": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg ocorrência fechada a menos de %2$lld m, registada desde %3$@"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg ocorrências fechadas a menos de %2$lld m, registadas desde %3$@"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%lld filed from this account. Statuses come from the council.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld registadas nesta conta. Os estados vêm da câmara."
          }
        }
      }
    },
    "%lld m away": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "a %lld m"
          }
        }
      }
    },
    "%lld m from your pin — close enough to be the same thing.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A %lld m do seu marcador — perto o suficiente para ser a mesma coisa."
          }
        }
      }
    },
    "%lld m from your pin — could be the same thing, or the next doorway.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A %lld m do seu marcador — pode ser a mesma coisa, ou a porta ao lado."
          }
        }
      }
    },
    "%lld m from your pin — probably a different spot.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A %lld m do seu marcador — provavelmente outro sítio."
          }
        }
      }
    },
    "%lld of them this year alone.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld delas só este ano."
          }
        }
      }
    },
    "%lld open reports are nearby, the closest %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld open reports are nearby, the closest %2$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Há %1$lld ocorrências abertas por perto, a mais próxima %2$@."
          }
        }
      }
    },
    "%lld open within %lld m": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld open within %2$lld m"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld abertas a menos de %2$lld m"
          }
        }
      }
    },
    "%lld types across %lld council areas. Several share wording and route to different desks, so the area is part of the answer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld types across %2$lld council areas. Several share wording and route to different desks, so the area is part of the answer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld tipos em %2$lld áreas municipais. Vários têm a mesma designação e seguem para serviços diferentes, por isso a área faz parte da resposta."
          }
        }
      }
    },
    "1 check outstanding": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "1 verificação por responder"
          }
        }
      }
    },
    "1 photo attached": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "1 fotografia anexada"
          }
        }
      }
    },
    "A collection request %@ is scheduled and not yet done. Filing sends a second worker to a job that is already on the list.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um pedido de recolha %@ agendado e ainda por executar. Registar envia um segundo funcionário a um trabalho que já está na lista."
          }
        }
      }
    },
    "A collection request is scheduled %@ and not yet done. Far enough to be a different pile — open it and see.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um pedido de recolha agendado %@ e ainda por fazer. Longe o suficiente para ser outra pilha — abra e veja."
          }
        }
      }
    },
    "A council worker will be dispatched to %@. This cannot be undone from the app.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Será enviado um funcionário da câmara a %@. Isto não pode ser anulado a partir da app."
          }
        }
      }
    },
    "A dry run works without a session. Filing does not — sign in from Settings first.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma simulação funciona sem sessão. Registar não — inicie sessão nas Definições primeiro."
          }
        }
      }
    },
    "A photo is the evidence a council worker acts on.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotografia é a prova sobre a qual o funcionário da câmara actua."
          }
        }
      }
    },
    "A worker will be dispatched. This cannot be withdrawn from the app — the number below is how you follow it up.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Será enviado um funcionário. Isto não pode ser retirado a partir da app — o número abaixo é como acompanha o processo."
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Chave de API"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca"
          }
        }
      }
    },
    "Account": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta"
          }
        }
      }
    },
    "Add a %@ API key in Settings to draft automatically, or write the report yourself.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma chave de API %@ nas Definições para redigir automaticamente, ou escreva a ocorrência você mesmo."
          }
        }
      }
    },
    "Add a note — optional": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar uma nota — opcional"
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Morada"
          }
        }
      }
    },
    "All checks answered": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as verificações respondidas"
          }
        }
      }
    },
    "All types": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os tipos"
          }
        }
      }
    },
    "Already booked — don't file this": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já está agendado — não registe isto"
          }
        }
      }
    },
    "Also likely here": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Também prováveis aqui"
          }
        }
      }
    },
    "Any language — the report is drafted in Portuguese.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em qualquer língua — a ocorrência é redigida em português."
          }
        }
      }
    },
    "Asking the council's server which address the pin lands on.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A perguntar ao servidor da câmara em que morada cai o marcador."
          }
        }
      }
    },
    "Asking whether a collection is already booked here.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A perguntar se já há uma recolha agendada aqui."
          }
        }
      }
    },
    "Back to review": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar à revisão"
          }
        }
      }
    },
    "Before this is filed": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de registar"
          }
        }
      }
    },
    "Both open the council's own site in Safari, so a password is only ever typed into cm-lisboa.pt.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos abrem o site da própria câmara no Safari, para que a palavra-passe só seja escrita em cm-lisboa.pt."
          }
        }
      }
    },
    "Build the payload": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Construir o pedido"
          }
        }
      }
    },
    "Build the payload without sending it?": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Construir o pedido sem o enviar?"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "Changes the app, not the report. What you file is always European Portuguese, because a council worker reads it — and you can edit every word of it before anything is sent.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda a app, não a ocorrência. O que regista é sempre em português europeu, porque é um funcionário da câmara que o lê — e pode editar todas as palavras antes de enviar seja o que for."
          }
        }
      }
    },
    "Check again": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificar outra vez"
          }
        }
      }
    },
    "Checked — you said yours is a new problem": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificado — disse que o seu é um problema novo"
          }
        }
      }
    },
    "Choose a report type": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher um tipo de ocorrência"
          }
        }
      }
    },
    "Chosen": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhido"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar"
          }
        }
      }
    },
    "Context for this spot": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Contexto sobre este sítio"
          }
        }
      }
    },
    "Coordinates are projected to EPSG:3763 on this phone rather than by the portal's server, which lands 114 m off. Checked against a reference point at launch and before every submission.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As coordenadas são projectadas para EPSG:3763 neste telemóvel em vez de no servidor do portal, que erra por 114 m. Verificadas contra um ponto de referência no arranque e antes de cada submissão."
          }
        }
      }
    },
    "Could not load the photographs — %@": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar as fotografias — %@"
          }
        }
      }
    },
    "Could not load your reports": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar as suas ocorrências"
          }
        }
      }
    },
    "Create an account": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Criar uma conta"
          }
        }
      }
    },
    "Creating an account opens the council's own site in Safari — signing up means agreeing to their privacy and data-protection terms.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Criar uma conta abre o site da própria câmara no Safari — registar-se implica aceitar os termos de privacidade e de protecção de dados dela."
          }
        }
      }
    },
    "Credentials are stored in the Keychain. Signing out discards the report in progress.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As credenciais ficam guardadas no Porta-chaves. Terminar sessão descarta a ocorrência em curso."
          }
        }
      }
    },
    "Decides which department is dispatched": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide que serviço é accionado"
          }
        }
      }
    },
    "Department": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviço"
          }
        }
      }
    },
    "Different problem": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Problema diferente"
          }
        }
      }
    },
    "Distance": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Distância"
          }
        }
      }
    },
    "Don't file it": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não registar"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Concluído"
          }
        }
